datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                   String         @id @default(uuid())
  username             String         @unique @default(cuid())
  prn                  String?        @unique
  email                String         @unique
  passwordHash         String
  role                 String         @default("STUDENT") // "STUDENT" | "ADMIN"
  fullName             String         @default("")
  displayName          String?
  shortId              String?
  college              String?
  department           String?
  year                 String?
  division             String?
  profileComplete      Boolean        @default(true)
  bio                  String?
  avatarUrl            String?
  totalPoints          Int            @default(0)
  currentStreak        Int            @default(0)
  longestStreak        Int            @default(0)
  lastSolvedDate       String?        // YYYY-MM-DD in IST
  isBanned             Boolean        @default(false)
  isCheckerPaused      Boolean        @default(false)
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  prnChangedAt         DateTime?      // Last student PRN change timestamp (cooldown gate)
  storagePreference    String?        @default("FIRESTORE_FALLBACK")
  hidePracticeTimer    Boolean        @default(false)
  mobile               String?        @unique
  accountState         String         @default("ACTIVE") // "PENDING" | "EMAIL_OTP_VERIFIED" | "MOBILE_OTP_VERIFIED" | "IDENTITY_BOUND" | "ACTIVE" | "SUSPENDED"
  emailOtpVerifiedAt   DateTime?
  mobileOtpVerifiedAt  DateTime?
  identityBoundAt      DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  prnIndexes           PrnIndex[]
  prnHistories         PrnHistory[]
  submissions          Submission[]
  uploadedSolutions    UploadedSolution[]
  assignedReviews      UploadedSolution[] @relation("AssignedChecker")
  userBadges           UserBadge[]
  refreshTokens        RefreshToken[]
  contestParticipants  ContestParticipant[]
  practiceProgress     PracticeProgress[]
  taughtSections       Section[]          @relation("FacultySections")
  enrolledSections     SectionStudent[]   @relation("StudentSections")
  createdTests         AssessmentTest[]   @relation("CreatedTests")
  testAssignments     AssessmentTestAssignment[] @relation("StudentTestAssignments")
  studentMiniProjects StudentMiniProjectAccess[] @relation("StudentMiniProjects")
  activatedMiniProjects StudentMiniProjectAccess[] @relation("FacultyActivatedMiniProjects")
}

model PrnIndex {
  prn           String    @id
  userId        String
  status        String    @default("ACTIVE") // "ACTIVE" | "RELEASED_RESERVED" | "BANNED"
  reservedUntil DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PrnHistory {
  id         String   @id @default(uuid())
  userId     String
  oldPrn     String
  newPrn     String
  source     String   @default("STUDENT") // "STUDENT" | "ADMIN"
  reason     String?
  deviceType String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model AdminAuditLog {
  id           String   @id @default(uuid())
  adminId      String
  targetUserId String?
  targetId     String?  // Generic target resource ID (e.g. uploadId, problemId)
  action       String
  oldValue     String?
  newValue     String?
  reason       String?
  createdAt    DateTime @default(now())

  @@index([adminId])
  @@index([targetUserId])
  @@index([targetId])
  @@index([createdAt])
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
}

model Problem {
  id                String             @id @default(uuid())
  slug              String             @unique
  title             String
  difficulty        String             @default("MEDIUM") // "EASY" | "MEDIUM" | "HARD"
  category          String             @default("Algorithms")
  tags              String             // JSON string array e.g. '["Pointers","Strings"]'
  description       String             // Markdown problem statement
  starterCode       String
  solutionCode      String?
  timeLimitMs       Int                @default(1000)
  memoryLimitMb     Int                @default(64)
  basePoints        Int                @default(20)
  isDaily           Boolean            @default(false)
  isPractice        Boolean            @default(false)
  moduleSlug        String?            // "control-structures", "pointers-functions", etc.
  moduleOrder       Int?               // 1..10 within module
  scheduledDate     String?            // YYYY-MM-DD in IST
  status            String             @default("PUBLISHED") // "DRAFT" | "PUBLISHED"
  sourceType        String             @default("SEED") // "SEED" | "BOOK" | "PRACTICE"
  sourceRefJson     String?            // Admin-only JSON metadata (bookId, chapter, section, exerciseNumber, page, concept)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  testCases         TestCase[]
  submissions       Submission[]
  uploadedSolutions UploadedSolution[]
  contestProblems   ContestProblem[]
  practiceProgress  PracticeProgress[]
  module            String?            // "Module 1", "Module 2", etc.
  section           String?            // "Section 1", "Section 2", "Section 3", "Section 4"
  topic             String?
  learningOutcome   String?
  bloomsLevel       String?            // "REMEMBER" | "UNDERSTAND" | "APPLY" | "ANALYZE" | "EVALUATE" | "CREATE"
  scenario          String?            // Real-world engineering scenario
  inputSpecification String?
  outputSpecification String?
  constraints       String?
  expectedTimeMin   Int?               // 2 for Easy, 8 for Medium, 15 for Hard
  expectedTimeMax   Int?               // 8 for Easy, 15 for Medium, 25 for Hard
  validationStatus  String             @default("PUBLISHED") // "DRAFT" | "AI_GENERATED" | "VALIDATION_FAILED" | "VALIDATION_PASSED" | "FACULTY_APPROVED" | "PUBLISHED" | "ARCHIVED"
  validationDetails String?            // JSON string with sandbox judge compilation & run logs on 3 test cases
  testQuestions     AssessmentTestQuestion[]
  assessmentAttempts AssessmentQuestionAttempt[]
}

model TestCase {
  id             String   @id @default(uuid())
  problemId      String
  problem        Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  input          String
  expectedOutput String
  isHidden       Boolean  @default(false)
  orderIndex     Int      @default(0)
}

model Submission {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId      String
  problem        Problem   @relation(fields: [problemId], references: [id], onDelete: Cascade)
  contestId      String?
  contest        Contest?  @relation(fields: [contestId], references: [id], onDelete: SetNull)
  submissionType String    @default("DAILY") // "DAILY" | "PRACTICE"
  code           String
  language       String    @default("c")
  verdict        String    @default("PENDING") // ACCEPTED, WRONG_ANSWER, TIME_LIMIT_EXCEEDED, RUNTIME_ERROR, COMPILE_ERROR, MEMORY_LIMIT_EXCEEDED, PENDING, JUDGING
  runtimeMs      Int?
  memoryKb       Int?
  compileOutput  String?
  pointsAwarded  Int       @default(0)
  createdAt      DateTime  @default(now())

  testCaseResults SubmissionTestCaseResult[]
}

model PracticeProgress {
  id                        String    @id @default(uuid())
  userId                    String
  user                      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId                 String
  problem                   Problem   @relation(fields: [problemId], references: [id], onDelete: Cascade)
  moduleSlug                String
  isSolved                  Boolean   @default(false)
  attemptsCount             Int       @default(0)
  runsCount                 Int       @default(0)
  activeSeconds             Int       @default(0)
  timeToSolveSeconds        Int?
  timeToFirstAttemptSeconds Int?
  firstAttemptAccepted      Boolean   @default(false)
  firstOpenedAt             DateTime?
  solvedAt                  DateTime?
  lastSyncedAt              DateTime?
  lastDeviceLabel           String?
  attemptsHistoryJson       String    @default("[]")
  hintsUsed                 Int       @default(0)
  updatedAt                 DateTime  @default(now()) @updatedAt

  @@unique([userId, problemId])
  @@index([userId, moduleSlug])
}

model SubmissionTestCaseResult {
  id           String      @id @default(uuid())
  submissionId String
  submission   Submission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  testCaseId   String
  verdict      String      // ACCEPTED, WRONG_ANSWER, TIME_LIMIT_EXCEEDED, RUNTIME_ERROR, COMPILE_ERROR
  runtimeMs    Int?
  stdout       String?
  stderr       String?
  orderIndex   Int         @default(0)
}

model Contest {
  id              String        @id @default(uuid())
  slug            String        @unique
  title           String
  description     String
  startTime       DateTime
  endTime         DateTime
  durationMinutes Int
  status          String        @default("UPCOMING") // UPCOMING, ONGOING, ENDED
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  problems        ContestProblem[]
  participants    ContestParticipant[]
  submissions     Submission[]
}

model ContestProblem {
  id         String   @id @default(uuid())
  contestId  String
  contest    Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)
  problemId  String
  problem    Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  orderIndex Int      @default(0)
  points     Int      @default(100)

  @@unique([contestId, problemId])
}

model ContestParticipant {
  id          String   @id @default(uuid())
  contestId   String
  contest     Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score       Int      @default(0)
  penaltyTime Int      @default(0)
  rank        Int?
  joinedAt    DateTime @default(now())

  @@unique([contestId, userId])
}

model Badge {
  id               String      @id @default(uuid())
  slug             String      @unique
  name             String
  description      String
  iconName         String
  category         String      // STREAK, SOLVE_COUNT, DIFFICULTY, CONTEST
  requirementCount Int         @default(1)

  userBadges       UserBadge[]
}

model UserBadge {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId    String
  badge      Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  unlockedAt DateTime @default(now())

  @@unique([userId, badgeId])
}

model UploadedSolution {
  id                String         @id @default(uuid())
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId         String
  problem           Problem        @relation(fields: [problemId], references: [id], onDelete: Cascade)
  weekId            String?
  dayIndex          Int?
  filesJson         String         // JSON array of FileItem { id, storageKey, mimeType, sizeBytes, sha256, width, height, pages, dataBase64 }
  studentNote       String         @default("")
  status            String         @default("PENDING_REVIEW") // "PENDING_REVIEW" | "APPROVED" | "REJECTED" | "NEEDS_CHANGES"
  pointsAwarded     Int            @default(0)
  reviewerId        String?
  reviewerComment   String?
  assignedCheckerId String?
  assignedChecker   User?          @relation("AssignedChecker", fields: [assignedCheckerId], references: [id], onDelete: SetNull)
  assignedAt        DateTime?
  suspicionFlag     Boolean        @default(false)
  suspicionNote     String?
  rubricScoresJson  String?        // JSON of rubric breakdown e.g. {"correctLogic": 1.0, "flowchart": 0.8, "clarity": 1.0}
  submittedAt       DateTime       @default(now())
  reviewedAt        DateTime?

  reviews           UploadReview[]

  @@index([userId, problemId])
  @@index([status])
  @@index([assignedCheckerId])
  @@index([submittedAt])
}

model UploadReview {
  id               String           @id @default(uuid())
  uploadId         String
  upload           UploadedSolution @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  reviewerId       String
  decision         String           // "APPROVED" | "REJECTED" | "NEEDS_CHANGES"
  pointsAwarded    Int              @default(0)
  rubricScoresJson String?          // JSON of rubric breakdown used for this decision
  comment          String           @default("")
  createdAt        DateTime         @default(now())

  @@index([uploadId])
  @@index([reviewerId])
}

model ErrorReport {
  id        String   @id @default(uuid())
  userId    String?
  route     String
  message   String
  stack     String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model SystemConfig {
  key       String   @id
  value     String   // Stringified JSON value
  updatedAt DateTime @default(now()) @updatedAt
  updatedBy String?
}



model OtpVerification {
  id          String    @id @default(uuid())
  target      String    // email address or mobile number
  type        String    // "EMAIL" | "MOBILE"
  codeHash    String    // bcrypt or sha256 hash of 6-digit OTP
  prn         String?   // optional PRN tied to verification flow
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  expiresAt   DateTime
  verified    Boolean   @default(false)
  verifiedAt  DateTime?
  ipAddress   String?
  createdAt   DateTime  @default(now())

  @@index([target, type])
  @@index([expiresAt])
}

model Section {
  id           String           @id @default(uuid())
  institution  String
  course       String
  subject      String
  academicYear String           // e.g. "2026-2027"
  semester     String           // e.g. "Semester 1"
  sectionName  String           // e.g. "Section A - CSE"
  facultyId    String
  description  String?
  joinCode     String           @unique // short code e.g. "LQ-CSE-A1"
  joinToken    String           @unique // unique UUID for QR & link
  startDate    DateTime?
  endDate      DateTime?
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  faculty      User             @relation("FacultySections", fields: [facultyId], references: [id], onDelete: Cascade)
  students     SectionStudent[]
  assessmentTests AssessmentTest[]

  @@index([facultyId])
  @@index([joinCode])
  @@index([joinToken])
}

model SectionStudent {
  id         String   @id @default(uuid())
  sectionId  String
  studentId  String
  prn        String
  status     String   @default("ENROLLED") // "ENROLLED" | "PENDING_VERIFICATION" | "DROPPED"
  joinedVia  String   @default("EXCEL_IMPORT") // "EXCEL_IMPORT" | "INSTANT_JOIN" | "FACULTY_ADD"
  enrolledAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  section    Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  student    User     @relation("StudentSections", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sectionId, studentId])
  @@unique([sectionId, prn])
  @@index([sectionId])
  @@index([studentId])
}


model AssessmentTest {
  id                 String                     @id @default(uuid())
  title              String
  sectionId          String
  section            Section                    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  moduleId           String                     // e.g. "Module 1", "Module 2"
  instructions       String?
  durationMinutes    Int                        @default(60)
  questionCount      Int                        @default(20) // e.g. 20 questions
  easyRatio          Int                        @default(40) // 40% Easy (2-8 min)
  mediumRatio        Int                        @default(40) // 40% Medium (8-15 min)
  hardRatio          Int                        @default(20) // 20% Hard (15-25 min)
  randomiseQuestions Boolean                    @default(true)
  startTime          DateTime?
  endTime            DateTime?
  attemptPolicy      String                     @default("STRICT_NO_REATTEMPT") // "STRICT_NO_REATTEMPT" | "ALLOW_ONE_RETRY"
  status             String                     @default("DRAFT") // "DRAFT" | "PUBLISHED" | "ACTIVE" | "COMPLETED" | "ARCHIVED"
  createdById        String
  createdBy          User                       @relation("CreatedTests", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  questions          AssessmentTestQuestion[]
  assignments        AssessmentTestAssignment[]

  @@index([sectionId])
  @@index([createdById])
  @@index([status])
}

model AssessmentTestQuestion {
  id         String         @id @default(uuid())
  testId     String
  test       AssessmentTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  problemId  String
  problem    Problem        @relation(fields: [problemId], references: [id], onDelete: Cascade)
  orderIndex Int            @default(0)
  marks      Int            @default(1)

  @@unique([testId, problemId])
  @@index([testId])
  @@index([problemId])
}

model AssessmentTestAssignment {
  id             String         @id @default(uuid())
  testId         String
  test           AssessmentTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  studentId      String
  student        User           @relation("StudentTestAssignments", fields: [studentId], references: [id], onDelete: Cascade)
  status         String         @default("ASSIGNED") // "ASSIGNED" | "IN_PROGRESS" | "SUBMITTED" | "EXPIRED"
  startedAt      DateTime?
  submittedAt    DateTime?
  academicScore  Float          @default(0)
  integrityScore Float          @default(0)
  integrityRisk  String         @default("NORMAL") // "NORMAL" | "LOW" | "MODERATE" | "HIGH" | "CRITICAL"
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  attempts       AssessmentQuestionAttempt[]
  successiveCorrectCount Int    @default(0) // Track sequence of correct submissions (Section 29)
  vivaQuestions  AssessmentVivaQuestion[]

  @@unique([testId, studentId])
  @@index([testId])
  @@index([studentId])
  @@index([status])
}


model AssessmentQuestionAttempt {
  id                         String                   @id @default(uuid())
  assignmentId               String
  assignment                 AssessmentTestAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  problemId                  String
  problem                    Problem                  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  questionVariantId          String                   // Unique variant ID per student instance (Section 34)
  startedAt                  DateTime                 @default(now())
  firstInteractionAt         DateTime?
  firstCodeEditAt            DateTime?
  firstExecutionAt           DateTime?
  firstPassT1At              DateTime?
  firstPassT2At              DateTime?
  firstPassT3At              DateTime?
  submittedAt                DateTime?
  isLocked                   Boolean                  @default(false) // Locked immediately upon successful submission (Section 7)
  academicScore              Float                    @default(0)     // 1.0 (inside time), 0.5 (outside time), 0.0 (incorrect) (Section 5)
  actualTimeTakenSec         Int?
  expectedRefTimeSec         Int?
  timeDeviationSec           Int?
  deviationPercent           Float?
  verdict                    String?                  // ACCEPTED, WRONG_ANSWER, TIME_LIMIT_EXCEEDED, etc.
  submittedCode              String?
  status                     String                   @default("IN_PROGRESS") // IN_PROGRESS | ACCEPTED | FAILED | LOCKED

  // Anti-Copying & Environment Metrics (Sections 20 & 21)
  copyPasteAttempts          Int                      @default(0)
  cutAttempts                Int                      @default(0)
  contextMenuAttempts        Int                      @default(0)
  tabSwitchCount             Int                      @default(0)
  focusLossCount             Int                      @default(0)
  totalFocusLossDurationMs   Int                      @default(0)
  longestFocusLossDurationMs  Int                      @default(0)
  fullScreenExitCount        Int                      @default(0)

  // Typing & Code Evolution Metrics (Sections 22 - 28)
  totalKeystrokes            Int                      @default(0)
  charsInserted              Int                      @default(0)
  charsDeleted               Int                      @default(0)
  cpm                        Float                    @default(0)
  wpm                        Float                    @default(0)
  linesAdded                 Int                      @default(0)
  linesDeleted               Int                      @default(0)
  largestBurstChars          Int                      @default(0)
  codeBurstRatio             Float                    @default(0)     // Largest Burst / Final Submitted Code Size
  activeInteractionTimeSec   Int                      @default(0)
  activeWorkRatio            Float                    @default(0)     // Active Time / Total Duration * 100
  editCount                  Int                      @default(0)
  executionCount             Int                      @default(0)
  compilationErrors          Int                      @default(0)
  runtimeErrors              Int                      @default(0)
  editToExecutionRatio       Float                    @default(0)
  solutionEmergenceJson      String?                  // JSON array of emergence checkpoints
  codeRevisionsJson          String?                  // JSON array of code revisions
  integrityScore             Float                    @default(0)     // Calculated Integrity Score 0-100 (Section 57)
  integrityRisk              String                   @default("NORMAL") // NORMAL | LOW | MODERATE | HIGH | CRITICAL (Section 58)
  suspiciousFlags            String?                  // JSON array of integrity alerts

  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt

  @@unique([assignmentId, problemId])
  @@index([assignmentId])
  @@index([problemId])
  @@index([questionVariantId])
  @@index([isLocked])
}

// AI Viva Verification Engine (Sections 29 - 33)
model AssessmentVivaQuestion {
  id                         String                   @id @default(uuid())
  assignmentId               String
  assignment                 AssessmentTestAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  attemptId                  String
  questionText               String
  codeContext                String                   // Snapshot of student's submitted C code that inspired the viva
  startedAt                  DateTime                 @default(now())
  submittedAt                DateTime?
  studentAnswer              String?
  responseDurationSec        Int?                     // Actual response time in seconds
  submittedBeforeTimeout     Boolean                  @default(false) // Strict 1-minute limit (Section 31)
  relevanceScore             Float?                   // AI evaluation relevance (0 - 100)
  aiEvaluation               String?                  // Qualitative feedback
  status                     String                   @default("PENDING") // "PENDING" | "COMPLETED" | "TIMED_OUT"
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt

  @@index([assignmentId])
  @@index([attemptId])
  @@index([status])
}

// Integrated Mini-Project Framework (Sections 35 - 39)
model MiniProject {
  id                         String                   @id @default(uuid())
  moduleId                   String
  title                      String
  scenario                   String                   // Multi-system real world scenario
  requirements               String                   // Detailed requirements combining Sections 1-4
  rubricJson                 String                   // JSON with 4 component rubrics (5 marks each = 20 total) (Section 35)
  starterCode                String?
  solutionCode               String?
  expectedTimeMin            Int                      @default(45)
  expectedTimeMax            Int                      @default(120)
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  studentAccess              StudentMiniProjectAccess[]
}

model StudentMiniProjectAccess {
  id                         String                   @id @default(uuid())
  miniProjectId              String
  miniProject                MiniProject              @relation(fields: [miniProjectId], references: [id], onDelete: Cascade)
  studentId                  String
  student                    User                     @relation("StudentMiniProjects", fields: [studentId], references: [id], onDelete: Cascade)
  sectionId                  String
  status                     String                   @default("INACTIVE") // INACTIVE by default (Section 36) | ACTIVE | SUBMITTED | EVALUATED
  activatedById              String?                  // Faculty ID who activated this individual student (Section 37)
  activatedBy                User?                    @relation("FacultyActivatedMiniProjects", fields: [activatedById], references: [id], onDelete: SetNull)
  activatedAt                DateTime?
  activationReason           String?                  // Audit log of activation (Section 38: no bulk activation)
  academicScore              Float                    @default(0)     // Out of 20 marks
  rubricScoresJson           String?                  // JSON breakdown of rubric scores (4 x 5 marks)
  submittedCode              String?
  submittedAt                DateTime?
  integrityScore             Float                    @default(0)
  integrityRisk              String                   @default("NORMAL")
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt

  @@unique([miniProjectId, studentId])
  @@index([studentId])
  @@index([sectionId])
  @@index([status])
}
