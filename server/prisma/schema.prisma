datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                   String         @id @default(uuid())
  username             String         @unique
  email                String         @unique
  passwordHash         String
  role                 String         @default("STUDENT") // "STUDENT" | "ADMIN"
  fullName             String
  college              String?
  bio                  String?
  avatarUrl            String?
  totalPoints          Int            @default(0)
  currentStreak        Int            @default(0)
  longestStreak        Int            @default(0)
  lastSolvedDate       String?        // YYYY-MM-DD in IST
  isBanned             Boolean        @default(false)
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  submissions          Submission[]
  userBadges           UserBadge[]
  refreshTokens        RefreshToken[]
  contestParticipants ContestParticipant[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
}

model Problem {
  id               String       @id @default(uuid())
  slug             String       @unique
  title            String
  difficulty       String       @default("MEDIUM") // "EASY" | "MEDIUM" | "HARD"
  category         String       @default("Algorithms")
  tags             String       // JSON string array e.g. '["Pointers","Strings"]'
  description      String       // Markdown problem statement
  starterCode      String
  solutionCode     String?
  timeLimitMs      Int          @default(1000)
  memoryLimitMb    Int          @default(64)
  basePoints       Int          @default(20)
  isDaily          Boolean      @default(false)
  scheduledDate    String?      // YYYY-MM-DD in IST
  status           String       @default("PUBLISHED") // "DRAFT" | "PUBLISHED"
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  testCases        TestCase[]
  submissions      Submission[]
  contestProblems  ContestProblem[]
}

model TestCase {
  id             String   @id @default(uuid())
  problemId      String
  problem        Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  input          String
  expectedOutput String
  isHidden       Boolean  @default(false)
  orderIndex     Int      @default(0)
}

model Submission {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId      String
  problem        Problem   @relation(fields: [problemId], references: [id], onDelete: Cascade)
  contestId      String?
  contest        Contest?  @relation(fields: [contestId], references: [id], onDelete: SetNull)
  code           String
  language       String    @default("c")
  verdict        String    @default("PENDING") // ACCEPTED, WRONG_ANSWER, TIME_LIMIT_EXCEEDED, RUNTIME_ERROR, COMPILE_ERROR, MEMORY_LIMIT_EXCEEDED, PENDING, JUDGING
  runtimeMs      Int?
  memoryKb       Int?
  compileOutput  String?
  pointsAwarded  Int       @default(0)
  createdAt      DateTime  @default(now())

  testCaseResults SubmissionTestCaseResult[]
}

model SubmissionTestCaseResult {
  id           String      @id @default(uuid())
  submissionId String
  submission   Submission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  testCaseId   String
  verdict      String      // ACCEPTED, WRONG_ANSWER, TIME_LIMIT_EXCEEDED, RUNTIME_ERROR, COMPILE_ERROR
  runtimeMs    Int?
  stdout       String?
  stderr       String?
  orderIndex   Int         @default(0)
}

model Contest {
  id              String        @id @default(uuid())
  slug            String        @unique
  title           String
  description     String
  startTime       DateTime
  endTime         DateTime
  durationMinutes Int
  status          String        @default("UPCOMING") // UPCOMING, ONGOING, ENDED
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  problems        ContestProblem[]
  participants    ContestParticipant[]
  submissions     Submission[]
}

model ContestProblem {
  id         String   @id @default(uuid())
  contestId  String
  contest    Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)
  problemId  String
  problem    Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  orderIndex Int      @default(0)
  points     Int      @default(100)

  @@unique([contestId, problemId])
}

model ContestParticipant {
  id          String   @id @default(uuid())
  contestId   String
  contest     Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score       Int      @default(0)
  penaltyTime Int      @default(0)
  rank        Int?
  joinedAt    DateTime @default(now())

  @@unique([contestId, userId])
}

model Badge {
  id               String      @id @default(uuid())
  slug             String      @unique
  name             String
  description      String
  iconName         String
  category         String      // STREAK, SOLVE_COUNT, DIFFICULTY, CONTEST
  requirementCount Int         @default(1)

  userBadges       UserBadge[]
}

model UserBadge {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId    String
  badge      Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  unlockedAt DateTime @default(now())

  @@unique([userId, badgeId])
}
