# ==========================================
# LogicQ Environment Variables Template (.env.example)
# DO NOT COMMIT REAL SECRETS OR KEYS TO THIS REPOSITORY
# ==========================================

# Server Configuration
NODE_ENV=
PORT=
CLIENT_URL=

# Database Connection (SQLite or PostgreSQL)
DATABASE_URL=

# JWT Secrets for Authentication
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=
JWT_REFRESH_EXPIRES_IN=

# Initial Admin Credentials (for seed)
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULLNAME=

# C11 Judge Subsystem (local_gcc | judge0 | docker)
JUDGE_TYPE=
GCC_PATH=
JUDGE0_URL=
JUDGE0_KEY=
JUDGE0_HOST=

# Redis Queue (Optional)
REDIS_URL=

# Mail Transport (Optional)
MAIL_PROVIDER=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Client Environment (Vite)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_API_URL=
