# ==========================================
# LogicQ Environment Variables Configuration
# ==========================================

# Environment Mode: development | test | production
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database (Default: local SQLite database file, zero config)
# To use PostgreSQL: postgresql://postgres:postgres@localhost:5432/logicq
DATABASE_URL="file:./dev.db"

# JWT Authentication
JWT_ACCESS_SECRET="logicq_super_secret_access_token_jwt_key_2026"
JWT_REFRESH_SECRET="logicq_super_secret_refresh_token_jwt_key_2026"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Default Initial Administrator Account (Created automatically via seed)
ADMIN_USERNAME="admin"
ADMIN_EMAIL="admin@logicq.io"
ADMIN_PASSWORD="AdminPassword123!"
ADMIN_FULLNAME="LogicQ System Administrator"

# Execution Judge Subsystem
# Options: local_gcc | judge0 | docker
JUDGE_TYPE=local_gcc
GCC_PATH=""

# Judge0 Configuration (Required only when JUDGE_TYPE=judge0)
JUDGE0_URL="https://judge0-ce.p.rapidapi.com"
JUDGE0_KEY=""
JUDGE0_HOST="judge0-ce.p.rapidapi.com"

# Queue Configuration
# If REDIS_URL is provided, BullMQ will be used; otherwise falls back to InMemoryQueue
REDIS_URL=""

# Mail Service
# Provider options: console | smtp
MAIL_PROVIDER=console
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="LogicQ Arena <no-reply@logicq.io>"
