# ==============================================================================
# LogicQ Environment Configuration Template (.env.example)
# DO NOT COMMIT ACTUAL PRODUCTION CREDENTIALS OR SECRETS TO SOURCE CONTROL
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
NODE_ENV=development                       # Options: development | production | test
PORT=5000                                 # Backend HTTP port (default: 5000)
CLIENT_URL=http://localhost:5173          # Frontend origin URL for CORS policy

# ------------------------------------------------------------------------------
# 2. Database Connection
# ------------------------------------------------------------------------------
# Local dev uses SQLite: file:./dev.db
# Production uses PostgreSQL: postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
DATABASE_URL=file:./dev.db

# ------------------------------------------------------------------------------
# 3. Authentication & JWT Security
# ------------------------------------------------------------------------------
# Required: 256-bit secret strings for JWT signing
JWT_ACCESS_SECRET=replace_with_a_secure_random_32_char_secret_key
JWT_REFRESH_SECRET=replace_with_a_different_secure_32_char_secret_key
JWT_ACCESS_EXPIRES_IN=15m                 # Access token lifespan
JWT_REFRESH_EXPIRES_IN=7d                 # Refresh token lifespan (7 days for students)

# ------------------------------------------------------------------------------
# 4. Bootstrap Administrator Credentials (for db:seed only)
# ------------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@sanjivani.edu.in
ADMIN_PASSWORD=ChangeMeOnFirstLogin!123
ADMIN_FULLNAME=System Administrator

# ------------------------------------------------------------------------------
# 5. C11 Code Judge Engine
# ------------------------------------------------------------------------------
# Subsystem type: local_gcc (default for local dev) | judge0 | docker
JUDGE_TYPE=local_gcc
GCC_PATH=gcc                              # Path to GCC binary (e.g. gcc, /usr/bin/gcc, C:\MinGW\bin\gcc.exe)

# Optional: Judge0 Remote API (if JUDGE_TYPE=judge0)
JUDGE0_URL=
JUDGE0_KEY=
JUDGE0_HOST=

# ------------------------------------------------------------------------------
# 6. Redis Queue Subsystem (Optional - In-Memory queue used when blank)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 7. Email Transport (Optional)
# ------------------------------------------------------------------------------
MAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@logicq.io

# ------------------------------------------------------------------------------
# 8. Frontend Client Configuration (Vite - prefixed with VITE_)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:5000/api     # Express API root
VITE_FIREBASE_API_KEY=                     # Firebase Web Client API Key
VITE_FIREBASE_AUTH_DOMAIN=logicq-clanguage.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=logicq-clanguage  # Firebase Project ID
VITE_FIREBASE_STORAGE_BUCKET=logicq-clanguage.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=898954156375
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
