rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// This security rules file assumes the following data structures:
//
// Collection: users/{userId} (Private Student Document - Contains PII)
// Document ID: Firebase Auth UID
// Fields:
//   - uid: string (required, immutable) - Firebase Auth UID
//   - prn: string (required, immutable by student, ^[0-9]{4}[A-Z]{3}[MF][0-9]{4}$) - 12-character University PRN (PII: 4 digits, 3 letters, M or F, 4 digits; masked as ••••••••1039 on client)
//   - email: string (required, immutable) - Student email address (PII)
//   - college: string (required, immutable by student) - 'Sanjivani University'
//   - department: string (required, enum) - 'CSE' | 'IT' | 'AIML' | 'AIDS' | 'Integrated M.Tech' | 'Mechanical' | 'Civil' | 'Electrical' | 'E&TC' | 'Integrated B.Tech'
//   - year: string (required, enum) - 'FY' | 'SY' | 'TY'
//   - division: string | null (optional, ^[A-Z0-9]{0,3}$) - Academic division
//   - displayName: string | null (optional, 2..60 chars) - Public display handle
//   - shortId: string (required, immutable) - Random non-PII fallback label suffix
//   - profileComplete: bool (required, server-managed) - Gates academic profile completion
//   - bio: string | null (optional, <= 500 chars) - Student bio
//   - photoURL: string | null (optional, <= 500 chars) - Avatar URL
//   - role: string (required, immutable) - 'STUDENT' | 'ADMIN'
//   - status: string (required, immutable) - 'ACTIVE' | 'BANNED'
//   - banReason: string (optional, immutable) - Reason if banned
//   - stats: map (required, immutable by client) - Server-computed points, streak, solved counts
//   - storagePreference: string (optional, enum) - 'GOOGLE_DRIVE' | 'FIRESTORE_FALLBACK' | 'LOCAL_STORAGE'
//   - themePreference: string (optional, enum) - 'light' | 'dark' | 'system'
//   - hidePracticeTimer: bool (optional) - Hide countdown/up timer display in practice workspace
//   - createdAt: timestamp (required, immutable)
//   - updatedAt: timestamp (required)
//
// Collection: prnIndex/{prn} (Transactional PRN Uniqueness Lock)
// Document ID: Canonical uppercase 12-character PRN (^[0-9]{4}[A-Z]{3}[MF][0-9]{4}$)
// Fields:
//   - prn: string (required, immutable)
//   - userId: string (required, immutable)
//   - createdAt: timestamp (required, immutable)
//
// Collection: publicProfiles/{userId} (Non-PII Public Mirror)
// Document ID: Firebase Auth UID
// Fields:
//   - uid: string (required, server-managed)
//   - publicLabel: string (required, server-managed)
//   - college: string (required, server-managed)
//   - department: string (required, server-managed)
//   - year: string (required, server-managed)
//   - division: string | null (optional, server-managed)
//   - bio: string | null (optional, <= 500 chars)
//   - stats: map (required, server-managed)
//   - updatedAt: timestamp (required, server-managed)
//
// Collection: practice_progress/{progressId} & users/{userId}/practice_progress/{progressId}
// Document ID: Progress record ID (e.g., {userId}_{problemId})
// Fields:
//   - userId: string (required) - Firebase Auth UID
//   - problemId: string (required) - Problem identifier
//   - status: string (required) - 'ATTEMPTED' | 'SOLVED'
//   - attempts: int (optional)
//   - solvedAt: timestamp (optional)
//   - updatedAt: timestamp (required)
//
// Collection: daily_boards/{dayId} (Authoritative Daily Board)
// Document ID: Canonical date string (YYYY-MM-DD)
// Fields:
//   - dayId: string (required, immutable)
//   - challengeId: string (required, immutable)
//   - scheduledDate: string (required, immutable)
//   - isFrozen: bool (required)
//   - totalSolvers: int (required)
//   - createdAt: timestamp (required)
//   - frozenAt: timestamp (optional)
//
// Subcollection: daily_boards/{dayId}/leaderboard/{docId}
// Document ID: Student UID
// Fields:
//   - userId: string (required)
//   - rank: int (required)
//   - score: int (required)
//   - wrongAttempts: int (required)
//   - submittedAt: timestamp (required)
//
// Collection: daily_results/{resultId} (Student Daily Solved Record)
// Document ID: Canonical format {dayId}_{userId}
// Fields:
//   - id: string (required)
//   - dayId: string (required)
//   - userId: string (required)
//   - challengeId: string (required)
//   - verdict: string (required)
//   - pointsAwarded: int (required)
//   - wrongAttempts: int (required)
//   - submittedAt: timestamp (required)
//   - rank: int (optional)
//
// Collection: daily_summaries/{summaryId} (Student Daily Summary Card)
// Document ID: Canonical format {dayId}_{userId}
// Fields:
//   - id: string (required)
//   - dayId: string (required)
//   - userId: string (required)
//   - verdict: string (required)
//   - pointsEarned: int (required)
//   - dailyRank: int (optional)
//   - totalParticipants: int (optional)
//   - streak: int (required)
//   - improvementHint: string (optional)
//
// Collection: daily_corrections/{correctionId} (Post-Finalization Rejudge / Audit Record)
// Document ID: Auto-generated UUID or timestamp-keyed ID
// Fields:
//   - id: string (required)
//   - dayId: string (required)
//   - userId: string (required)
//   - reason: string (required)
//   - adminId: string (required)
//   - createdAt: timestamp (required)
//
// Collection: daily_rank_snapshots/{snapshotId} (Frozen Daily Top 20 & Rank Snapshots)
// Document ID: Canonical snapshot identifier (e.g. {dayId}_top20)
// Fields:
//   - dayId: string (required)
//   - snapshotType: string (required)
//   - standings: list (required)
//   - createdAt: timestamp (required)
//
// Collection: session_events/{eventId} & users/{userId}/session_events/{eventId} (Session Lifecycle & Audit Ledger)
// Document ID: Unique session event identifier (UUID or timestamp-keyed)
// Fields:
//   - userId: string (required, immutable) - Firebase Auth UID
//   - reason: string (required, enum) - 'manual' | 'idle-timeout' | 'token-refresh-failed' | 'revoked-by-user' | 'revoked-by-admin' | 'role-changed' | 'banned' | 'app-check-failed' | 'unusual-login-flag' | 'multi-tab-sync' | 'service-worker-update' | 'unknown'
//   - timestamp: timestamp (optional)
//
// Collection: sections/{sectionId} (Academic Sections)
// Document ID: Unique section identifier
// Fields:
//   - sectionName / name: string (required, 1..100 chars)
//   - course: string (required, 1..100 chars)
//   - subject: string (required, 1..100 chars)
//   - institution: string (optional, <= 100 chars)
//   - academicYear: string (optional, <= 50 chars)
//   - semester: string (optional, <= 50 chars)
//   - facultyId: string (optional, <= 128 chars)
//   - facultyEmail: string (optional, <= 150 chars)
//   - facultyName: string (optional, <= 100 chars)
//   - description: string | null (optional, <= 1000 chars)
//   - joinCode: string (optional, <= 32 chars)
//   - joinToken: string (optional, <= 128 chars)
//   - isActive: bool (optional)
//   - createdAt: timestamp (optional)
//   - updatedAt: timestamp (optional)
//
// Subcollection: sections/{sectionId}/students/{studentId} (Enrolled Students Roster)
// Document ID: Student UID, PRN, or membership ID
// Fields:
//   - studentId / userId / uid: string (optional, <= 128 chars)
//   - prn: string (optional, <= 30 chars)
//   - fullName / name: string (optional, <= 100 chars)
//   - email: string (optional, <= 150 chars)
//   - mobile: string | null (optional, <= 25 chars)
//   - status: string (optional, <= 50 chars)
//   - joinedVia: string (optional, <= 50 chars)
//   - enrolledAt: timestamp (optional)
//
// Collection: enrolled_students/{studentId} (Global Enrolled Students Registry)
// Document ID: Student UID, student email, or PRN
// Fields:
//   - studentId / userId / uid: string (optional, <= 128 chars)
//   - email: string (optional, <= 150 chars)
//   - prn: string (optional, <= 30 chars)
//   - fullName / name: string (optional, <= 100 chars)
//   - sectionId: string (optional, <= 100 chars)
//   - joinCode: string (optional, <= 50 chars)
//   - sectionName: string (optional, <= 100 chars)
//   - course: string (optional, <= 100 chars)
//   - subject: string (optional, <= 100 chars)
//   - status: string (optional, <= 50 chars)
//   - college: string (optional, <= 100 chars)
//   - department: string (optional, <= 50 chars)
//   - year: string (optional, <= 20 chars)
//   - division: string | null (optional, <= 20 chars)
//   - joinedVia: string (optional, <= 50 chars)
//   - enrolledAt: timestamp (optional)
//   - isBanned: bool (optional)
//   - bannedAt: string | timestamp (optional, <= 100 chars)
//   - banReason: string | null (optional, <= 200 chars)
//
// Collection: cohort_progress/{prn} (Cross-Device Cohort Progress Synchronization)
// Document ID: Canonical Student PRN (<= 30 chars)
// Fields:
//   - prn: string (required, <= 30 chars)
//   - completedProblems: list (optional, <= 250 items)
//   - totalSolved: int (optional)
//   - totalPoints: int (optional)
//   - currentStreak: int (optional)
//   - longestStreak: int (optional)
//   - lastSolvedDate: string | null (optional, <= 100 chars)
//   - draftCodes: map (optional)
//   - moduleProgress: map (optional)
//   - updatedAt: timestamp | int | string (optional)
//   - isBanned: bool (optional)
//   - bannedAt: string | timestamp (optional, <= 100 chars)
//   - banReason: string | null (optional, <= 200 chars)
//
// Subcollection: cohort_progress/{prn}/drafts/{draftId}
// Document ID: Draft ID (e.g. problemSlug)
// Fields:
//   - code: string (required, <= 65536 chars)
//   - customInput: any (optional)
//   - updatedAt: any (optional)
//   - problemSlug: any (optional)
//   - deviceLabel: any (optional)
//
// Collection: assessment_tests/{testId} (Timed Assessment & Lab Tests)
// Document ID: Unique assessment identifier (e.g., test_{uuid} or slug)
// Fields:
//   - id: string (required, <= 128 chars)
//   - title: string (required, 1..200 chars)
//   - sectionTarget: string (optional, <= 100 chars)
//   - sectionId: string (optional, <= 100 chars)
//   - unitTarget: any (optional)
//   - durationMinutes: int (optional)
//   - totalMarks: int (optional)
//   - status: string (required, <= 50 chars) - 'ACTIVE' | 'PUBLISHED' | 'UPCOMING' | 'COMPLETED'
//   - questions: list (optional, <= 100 items)
//   - questionCount: any (optional)
//   - antiCheatingRotation: bool (optional)
//   - randomiseQuestions: bool (optional)
//   - lockOnSubmit: bool (optional)
//   - difficultyProfile: string (optional, <= 50 chars)
//   - selectionMode: string (optional, <= 50 chars)
//   - scheduledAt: timestamp | int | string (optional)
//   - deadline: timestamp | int | string (optional)
//   - createdAt: timestamp | int | string (optional)
//   - updatedAt: timestamp | int | string (optional)
//
// Collection: assessment_test_submissions/{docId} & assessment_submissions/{docId} (Assessment Test Submissions & Answer Bank)
// Document ID: Unique assessment submission document identifier
// Fields:
//   - assignmentId / testId: string (optional, <= 128 chars)
//   - testTitle: string (optional, <= 200 chars)
//   - userId / uid / studentId: string (optional, <= 128 chars)
//   - studentName / name: string (optional, <= 100 chars)
//   - studentPrn / prn: string (optional, <= 30 chars)
//   - studentEmail / email: string (optional, <= 150 chars)
//   - problemId: string (optional, <= 128 chars)
//   - problemTitle: string (optional, <= 200 chars)
//   - code: string (optional, <= 65536 chars)
//   - verdict: string (optional, <= 50 chars)
//   - academicScore / score / marks / pointsAwarded: int | float (optional)
//   - integrityScore / testIntegrityScore: int | float (optional)
//   - timeTakenSeconds / tabSwitchCount / copyPasteAttempts / cutAttempts / contextMenuAttempts: int (optional)
//   - fullscreenExits / fullScreenExitCount / totalKeystrokes / largestBurstChars: int (optional)
//   - incidents: list (optional, <= 200 items)
//   - submittedAt / createdAt / updatedAt / lastHeartbeat / startedAt: timestamp | int | string (optional)
//   - submissionType / status / difficulty / language / tag: string (optional, <= 50 chars)
//   - runtimeMs / memoryKb / executionTimeMs: int | float (optional)
//   - compileOutput: string (optional, <= 5000 chars)
//   - quarantinedAttempt / isCheatAutoSubmit / isCheatAttempt: bool (optional)
//   - cheatReason: string (optional, <= 500 chars)
//   - problem / user / metadata: map (optional)
//   - sectionId: string (optional, <= 100 chars)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // 0. DENY BY DEFAULT TOP-LEVEL PERIMETER
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Helper Functions & Domain Validators
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'ADMIN'
        || (request.auth.token.email is string && request.auth.token.email.lower() in [
          'admin@logicq.io',
          'hariprasathset@sanjivani.edu.in',
          'logicq1304@gmail.com',
          'ipworker1908@gmail.com',
          'ipverse1918@gmail.com',
          'logicqarena@gmail.com'
        ])
      );
    }

    function isInstitutionalEmail(email) {
      return email is string && (
        email.lower().matches('^[a-zA-Z0-9._%+-]+@([a-zA-Z0-9.-]+\\.)?(sanjivani\\.edu\\.in|sanjivani\\.org\\.in|sanjivanicoe\\.org\\.in|logicq\\.io)$')
      );
    }

    function isFaculty() {
      return isAuthenticated() && (
        isAdmin() || (
          (request.auth.token.role == 'FACULTY' || request.auth.token.role == 'TEACHER' || request.auth.token.role == 'INSTRUCTOR' || request.auth.token.isFaculty == true)
          && isInstitutionalEmail(request.auth.token.email)
        )
      );
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }

    function isAllowedDepartment(dept) {
      return dept is string &&
        dept in ['CSE', 'IT', 'AIML', 'AIDS', 'Integrated M.Tech', 'Mechanical', 'Civil', 'Electrical', 'E&TC', 'Integrated B.Tech'];
    }

    function isAllowedYear(yr) {
      return yr is string &&
        yr in ['FY', 'SY', 'TY'];
    }

    function isValidDivision(div) {
      return div == null ||
        (div is string && div.size() <= 3 && div.matches('^[A-Z0-9]{0,3}$'));
    }

    function isValidDisplayName(name) {
      return name == null ||
        (name is string && name.size() >= 2 && name.size() <= 60);
    }

    function isValidUserSelfUpdate() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      let data = request.resource.data;
      return uidNotModified()
        && changedKeys.hasOnly([
          'department', 'year', 'division', 'displayName',
          'bio', 'photoURL', 'storagePreference', 'themePreference', 'hidePracticeTimer', 'updatedAt'
        ])
        && !changedKeys.hasAny([
          'prn', 'college', 'email', 'role', 'status', 'banReason',
          'stats', 'points', 'totalPoints', 'streak', 'currentStreak',
          'prnChangedAt', 'prnNextAllowedChangeDate'
        ])
        && (!('department' in data) || data.department == null || isAllowedDepartment(data.department))
        && (!('year' in data) || data.year == null || isAllowedYear(data.year))
        && (!('division' in data) || isValidDivision(data.division))
        && (!('displayName' in data) || isValidDisplayName(data.displayName))
        && (!('bio' in data) || data.bio == null || (data.bio is string && data.bio.size() <= 500))
        && (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 500))
        && (!('storagePreference' in data) || data.storagePreference in ['GOOGLE_DRIVE', 'FIRESTORE_FALLBACK', 'LOCAL_STORAGE'])
        && (!('themePreference' in data) || data.themePreference in ['light', 'dark', 'system'])
        && (!('hidePracticeTimer' in data) || data.hidePracticeTimer is bool);
    }

    // -------------------------------------------------------------------------
    // 1. USERS, PRN INDEX & PUBLIC PROFILES COLLECTIONS
    // -------------------------------------------------------------------------
    match /users/{userId} {
      // Private student document (holds PII: prn & email).
      // Strictly readable ONLY by the document owner or an Admin.
      allow read: if isOwner(userId) || isAdmin();

      // Validates initial student onboarding profile created directly from the client.
      // Strictly locks role to STUDENT, college to Sanjivani University, initial points/streak to 0,
      // and ensures PRN format and prnIndex uniqueness before document creation.
      function isValidInitialUserCreate() {
        return request.resource.data.uid == request.auth.uid
          && request.resource.data.email.lower() == request.auth.token.email.lower()
          && request.resource.data.role == 'STUDENT'
          && request.resource.data.college == 'Sanjivani University'
          && isAllowedDepartment(request.resource.data.department)
          && isAllowedYear(request.resource.data.year)
          && (!('division' in request.resource.data) || isValidDivision(request.resource.data.division))
          && (!('displayName' in request.resource.data) || isValidDisplayName(request.resource.data.displayName))
          && request.resource.data.prn is string && request.resource.data.prn.matches('^[0-9]{4}[A-Z]{3}[MF][0-9]{4}$')
          && !exists(/databases/$(database)/documents/prnIndex/$(request.resource.data.prn))
          && request.resource.data.totalPoints == 0
          && request.resource.data.currentStreak == 0
          && request.resource.data.profileComplete == true;
      }

      function isInitialOnboardingUpdate() {
        return (!('profileComplete' in resource.data) || resource.data.profileComplete != true || !('prn' in resource.data))
          && isValidInitialUserCreate();
      }

      // Initial student profile onboarding directly from the client, or admin initialization:
      allow create: if (isOwner(userId) && isValidInitialUserCreate()) || isAdmin();

      // Students can update allowed self-service academic/profile fields, or complete initial onboarding
      // if their user document was previously uncompleted.
      // Once profileComplete is true, PRN, college, email, role, status, banReason, points, and streak remain strictly immutable.
      // Admins are permitted to perform administrative updates.
      allow update: if (isOwner(userId) && (isValidUserSelfUpdate() || isInitialOnboardingUpdate())) || isAdmin();

      // Account deletion is handled strictly by the server account deletion
      // transaction that also frees prnIndex/{prn} and scrubs PII.
      allow delete: if false;

      // PRN change audit trail: readable by the student owner or Admin; writes strictly by server
      match /prnHistory/{historyId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false;
      }

      // Private fallback drafts (used only when Google Drive is unavailable/blocked)
      match /drafts/{draftId} {
        allow read, write: if isOwner(userId);
      }

      // Practice progress subcollection tracking: readable by student owner or Admin; writes strictly by server
      match /practice_progress/{progressId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false;
      }

      // Session events audit subcollection
      match /session_events/{eventId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.reason in ['manual', 'idle-timeout', 'token-refresh-failed', 'revoked-by-user', 'revoked-by-admin', 'role-changed', 'banned', 'app-check-failed', 'unusual-login-flag', 'multi-tab-sync', 'service-worker-update', 'unknown'];
        allow update, delete: if false;
      }

      // Badges subcollections are disabled (FEATURE_BADGES=false) and strictly denied
      match /badges/{badgeId=**} {
        allow read, write: if false;
      }

      match /user_badges/{docId=**} {
        allow read, write: if false;
      }
    }

    match /prnIndex/{prn} {
      // Document ID is the canonical uppercase 12-character PRN (^[0-9]{4}[A-Z]{3}[MF][0-9]{4}$).
      // Allows authenticated owner to register their unique PRN index during onboarding:
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.prn == prn
        && prn.matches('^[0-9]{4}[A-Z]{3}[MF][0-9]{4}$')
        && !exists(/databases/$(database)/documents/prnIndex/$(prn));
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      // Allows idempotent update by the same authenticated owner:
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.prn == prn;
      allow delete: if false;
    }

    match /publicProfiles/{userId} {
      // Non-PII public profile mirror for leaderboards and peer views (never contains prn or email)
      allow read: if isAuthenticated();
      allow create, update: if (
        (isOwner(userId)
          && request.resource.data.userId == request.auth.uid
          && (!('role' in request.resource.data) || request.resource.data.role == 'STUDENT' || isAdmin())
        ) || isAdmin()
      )
      && !('prn' in request.resource.data) && !('email' in request.resource.data)
      && (!('bio' in request.resource.data) || request.resource.data.bio == null || (request.resource.data.bio is string && request.resource.data.bio.size() <= 500));
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // 2. PROBLEMS COLLECTION (SINGLE VISIBLE QUESTION AT A TIME — SERVER-SERVED ONLY)
    // -------------------------------------------------------------------------
    match /problems/{problemId} {
      // Students have NO direct client read access to the problems collection.
      // Today's active challenge is served strictly via the server endpoint
      // getCurrentChallenge (GET /api/problems/daily) with short TTL expiring at the next 17:00 IST.
      allow read: if isAdmin();
      allow write: if isAdmin();

      // HIDDEN TEST CASES SUBCOLLECTION:
      // Restricted strictly to Admin / Server SDK — never readable by students
      match /hidden_tests/{testId} {
        allow read, write: if isAdmin();
      }

      // PRIVATE METADATA SUBCOLLECTION (e.g., book sourceRef: chapter, exerciseNumber, page):
      // Strictly restricted to Admin only — never readable by students
      match /private_metadata/{docId} {
        allow read, write: if isAdmin();
      }
    }

    // -------------------------------------------------------------------------
    // 3. SUBMISSIONS & UPLOADED SOLUTIONS COLLECTIONS
    // -------------------------------------------------------------------------
    function isValidAssessmentSubmission(data) {
      let allowedKeys = [
        'id', 'assignmentId', 'testId', 'testTitle', 'userId', 'uid', 'studentId',
        'studentName', 'name', 'studentPrn', 'prn', 'studentEmail', 'email',
        'problemId', 'problemTitle', 'problemSlug', 'code', 'verdict', 'academicScore', 'score',
        'marks', 'pointsAwarded', 'marksAwarded', 'maxMarks', 'isLate', 'lateStatus',
        'manualGradingRequired', 'allocatedDurationMinutes', 'timeLimitSeconds',
        'attemptNumber', 'expectedMinMinutes', 'expectedMaxMinutes', 'expectedRefTimeSeconds',
        'timeDeviationSeconds', 'deviationPercent', 'timeTakenSeconds', 'timeToSolveSeconds',
        'activeSeconds', 'tabSwitchCount', 'copyPasteAttempts', 'cutAttempts',
        'contextMenuAttempts', 'fullscreenExits', 'fullScreenExitCount', 'totalKeystrokes',
        'largestBurstChars', 'incidents', 'submittedAt', 'createdAt', 'updatedAt',
        'submissionType', 'status', 'difficulty', 'language', 'runtimeMs', 'memoryKb',
        'compileOutput', 'tag', 'quarantinedAttempt', 'isCheatAutoSubmit', 'isCheatAttempt',
        'cheatReason', 'problem', 'user', 'sectionId', 'metadata', 'executionTimeMs',
        'integrityScore', 'testIntegrityScore', 'lastHeartbeat', 'startedAt'
      ];
      return data.keys().hasOnly(allowedKeys)
        && (!('assignmentId' in data) || data.assignmentId == null || (data.assignmentId is string && data.assignmentId.size() <= 128))
        && (!('testId' in data) || data.testId == null || (data.testId is string && data.testId.size() <= 128))
        && (!('testTitle' in data) || data.testTitle == null || (data.testTitle is string && data.testTitle.size() <= 200))
        && (!('userId' in data) || data.userId == null || (data.userId is string && data.userId.size() <= 128))
        && (!('uid' in data) || data.uid == null || (data.uid is string && data.uid.size() <= 128))
        && (!('studentId' in data) || data.studentId == null || (data.studentId is string && data.studentId.size() <= 128))
        && (!('studentName' in data) || data.studentName == null || (data.studentName is string && data.studentName.size() <= 100))
        && (!('name' in data) || data.name == null || (data.name is string && data.name.size() <= 100))
        && (!('studentPrn' in data) || data.studentPrn == null || (data.studentPrn is string && data.studentPrn.size() <= 30))
        && (!('prn' in data) || data.prn == null || (data.prn is string && data.prn.size() <= 30))
        && (!('studentEmail' in data) || data.studentEmail == null || (data.studentEmail is string && data.studentEmail.size() <= 150))
        && (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 150))
        && (!('problemId' in data) || data.problemId == null || (data.problemId is string && data.problemId.size() <= 128))
        && (!('problemTitle' in data) || data.problemTitle == null || (data.problemTitle is string && data.problemTitle.size() <= 200))
        && (!('problemSlug' in data) || data.problemSlug == null || (data.problemSlug is string && data.problemSlug.size() <= 128))
        && (!('code' in data) || data.code == null || (data.code is string && data.code.size() <= 65536))
        && (!('verdict' in data) || data.verdict == null || (data.verdict is string && data.verdict.size() <= 50))
        && (!('academicScore' in data) || data.academicScore == null || data.academicScore is int || data.academicScore is float)
        && (!('score' in data) || data.score == null || data.score is int || data.score is float)
        && (!('marks' in data) || data.marks == null || data.marks is int || data.marks is float)
        && (!('pointsAwarded' in data) || data.pointsAwarded == null || data.pointsAwarded is int || data.pointsAwarded is float)
        && (!('marksAwarded' in data) || data.marksAwarded == null || data.marksAwarded is int || data.marksAwarded is float)
        && (!('maxMarks' in data) || data.maxMarks == null || data.maxMarks is int || data.maxMarks is float)
        && (!('isLate' in data) || data.isLate == null || data.isLate is bool)
        && (!('lateStatus' in data) || data.lateStatus == null || (data.lateStatus is string && data.lateStatus.size() <= 50))
        && (!('manualGradingRequired' in data) || data.manualGradingRequired == null || data.manualGradingRequired is bool)
        && (!('allocatedDurationMinutes' in data) || data.allocatedDurationMinutes == null || data.allocatedDurationMinutes is int || data.allocatedDurationMinutes is float)
        && (!('timeLimitSeconds' in data) || data.timeLimitSeconds == null || data.timeLimitSeconds is int || data.timeLimitSeconds is float)
        && (!('attemptNumber' in data) || data.attemptNumber == null || data.attemptNumber is int)
        && (!('expectedMinMinutes' in data) || data.expectedMinMinutes == null || data.expectedMinMinutes is int || data.expectedMinMinutes is float)
        && (!('expectedMaxMinutes' in data) || data.expectedMaxMinutes == null || data.expectedMaxMinutes is int || data.expectedMaxMinutes is float)
        && (!('expectedRefTimeSeconds' in data) || data.expectedRefTimeSeconds == null || data.expectedRefTimeSeconds is int || data.expectedRefTimeSeconds is float)
        && (!('timeDeviationSeconds' in data) || data.timeDeviationSeconds == null || data.timeDeviationSeconds is int || data.timeDeviationSeconds is float)
        && (!('deviationPercent' in data) || data.deviationPercent == null || data.deviationPercent is int || data.deviationPercent is float)
        && (!('timeTakenSeconds' in data) || data.timeTakenSeconds == null || data.timeTakenSeconds is int || data.timeTakenSeconds is float)
        && (!('timeToSolveSeconds' in data) || data.timeToSolveSeconds == null || data.timeToSolveSeconds is int || data.timeToSolveSeconds is float)
        && (!('activeSeconds' in data) || data.activeSeconds == null || data.activeSeconds is int || data.activeSeconds is float)
        && (!('tabSwitchCount' in data) || data.tabSwitchCount == null || data.tabSwitchCount is int)
        && (!('copyPasteAttempts' in data) || data.copyPasteAttempts == null || data.copyPasteAttempts is int)
        && (!('cutAttempts' in data) || data.cutAttempts == null || data.cutAttempts is int)
        && (!('contextMenuAttempts' in data) || data.contextMenuAttempts == null || data.contextMenuAttempts is int)
        && (!('fullscreenExits' in data) || data.fullscreenExits == null || data.fullscreenExits is int)
        && (!('fullScreenExitCount' in data) || data.fullScreenExitCount == null || data.fullScreenExitCount is int)
        && (!('totalKeystrokes' in data) || data.totalKeystrokes == null || data.totalKeystrokes is int)
        && (!('largestBurstChars' in data) || data.largestBurstChars == null || data.largestBurstChars is int)
        && (!('incidents' in data) || data.incidents == null || (data.incidents is list && data.incidents.size() <= 200))
        && (!('submittedAt' in data) || data.submittedAt == null || data.submittedAt is timestamp || data.submittedAt is int || (data.submittedAt is string && data.submittedAt.size() <= 100))
        && (!('createdAt' in data) || data.createdAt == null || data.createdAt is timestamp || data.createdAt is int || (data.createdAt is string && data.createdAt.size() <= 100))
        && (!('updatedAt' in data) || data.updatedAt == null || data.updatedAt is timestamp || data.updatedAt is int || (data.updatedAt is string && data.updatedAt.size() <= 100))
        && (!('submissionType' in data) || data.submissionType == null || (data.submissionType is string && data.submissionType.size() <= 50))
        && (!('status' in data) || data.status == null || (data.status is string && data.status.size() <= 50))
        && (!('id' in data) || data.id == null || (data.id is string && data.id.size() <= 128))
        && (!('difficulty' in data) || data.difficulty == null || (data.difficulty is string && data.difficulty.size() <= 50))
        && (!('language' in data) || data.language == null || (data.language is string && data.language.size() <= 50))
        && (!('runtimeMs' in data) || data.runtimeMs == null || data.runtimeMs is int || data.runtimeMs is float)
        && (!('memoryKb' in data) || data.memoryKb == null || data.memoryKb is int || data.memoryKb is float)
        && (!('compileOutput' in data) || data.compileOutput == null || (data.compileOutput is string && data.compileOutput.size() <= 5000))
        && (!('tag' in data) || data.tag == null || (data.tag is string && data.tag.size() <= 50))
        && (!('quarantinedAttempt' in data) || data.quarantinedAttempt == null || data.quarantinedAttempt is bool)
        && (!('isCheatAutoSubmit' in data) || data.isCheatAutoSubmit == null || data.isCheatAutoSubmit is bool)
        && (!('isCheatAttempt' in data) || data.isCheatAttempt == null || data.isCheatAttempt is bool)
        && (!('cheatReason' in data) || data.cheatReason == null || (data.cheatReason is string && data.cheatReason.size() <= 500))
        && (!('problem' in data) || data.problem == null || data.problem is map)
        && (!('user' in data) || data.user == null || data.user is map)
        && (!('sectionId' in data) || data.sectionId == null || (data.sectionId is string && data.sectionId.size() <= 100))
        && (!('metadata' in data) || data.metadata == null || data.metadata is map)
        && (!('executionTimeMs' in data) || data.executionTimeMs == null || data.executionTimeMs is int || data.executionTimeMs is float)
        && (!('integrityScore' in data) || data.integrityScore == null || data.integrityScore is int || data.integrityScore is float)
        && (!('testIntegrityScore' in data) || data.testIntegrityScore == null || data.testIntegrityScore is int || data.testIntegrityScore is float)
        && (!('lastHeartbeat' in data) || data.lastHeartbeat == null || data.lastHeartbeat is timestamp || data.lastHeartbeat is int || (data.lastHeartbeat is string && data.lastHeartbeat.size() <= 100))
        && (!('startedAt' in data) || data.startedAt == null || data.startedAt is timestamp || data.startedAt is int || (data.startedAt is string && data.startedAt.size() <= 100));
    }

    function isValidSubmission(data) {
      return isValidAssessmentSubmission(data);
    }

    match /submissions/{submissionId} {
      // Publicly readable so Admin console listeners (operating under backend JWT where request.auth is null),
      // faculty analytics, and client apps can stream submission updates in real-time.
      allow read: if true;

      // Allow create and update for authenticated students / web clients submitting their solution,
      // as well as faculty and admin:
      allow create, update: if isFaculty() || isAdmin() || isValidSubmission(request.resource.data) || isValidAssessmentSubmission(request.resource.data);

      // Deletion restricted to faculty and admins:
      allow delete: if isAdmin() || isFaculty();
    }

    match /practice_progress/{progressId} {
      // Students can ONLY read their own practice progress; Admins can read all.
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      // Practice progress is updated strictly on the server by the judge evaluation service via Firebase Admin SDK
      allow write: if false;
    }

    match /practiceProgress/{userId}/questions/{problemId} {
      // Per-student question timer & attempt records: readable by student owner or Admin; writes strictly by server
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    match /uploaded_solutions/{uploadId} {
      // Students can ONLY read their own uploaded solution; never another student's. Admins can read all.
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );

      // Creation, status changes, pointsAwarded, and reviewerComment happen strictly on the server
      // via /api/uploads and /api/admin/uploads.
      allow write: if false;
    }

    match /upload_reviews/{reviewId} {
      // Upload review audit trail: readable by Admin only, written strictly on the server
      allow read: if isAdmin();
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // 4. DAILY COMPETITION ARCHITECTURE & LEADERBOARDS
    // -------------------------------------------------------------------------
    match /daily_boards/{dayId} {
      // Authoritative daily board storage: readable by authenticated students and admins
      allow read: if isAuthenticated();
      allow write: if false;

      // Daily live & frozen leaderboard subcollection
      match /leaderboard/{docId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }
    }

    match /daily_results/{resultId} {
      // Students can ONLY read their own daily result; Admins can read all
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create, update, delete: if false;
    }

    match /daily_summaries/{summaryId} {
      // Students can ONLY read their own daily summary; Admins can read all
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create, update, delete: if false;
    }

    match /daily_corrections/{correctionId} {
      // Post-finalization rejudge & late-upload corrections: Admin only
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /daily_rank_snapshots/{snapshotId} {
      // Frozen top 20 and daily rank snapshots: readable by authenticated users
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // 4.1 LEGACY COMPETITION ARCHIVE (HISTORICAL WEEKS & WEEKLY SUMMARIES)
    // -------------------------------------------------------------------------
    match /weeks/{weekId} {
      allow read: if isAuthenticated();
      // Clients can NEVER write or freeze weeks; managed strictly by Server / Admin SDK
      allow write: if false;

      // Daily scheduled challenges inside a week: readable only after 17:00 IST unlockAt
      match /days/{dayNumber} {
        allow read: if isAuthenticated() && (
          resource.data.unlockAt <= request.time || isAdmin()
        );
        allow write: if false; // Written only by Admin API / 17:00 IST Auto-Fallback
      }

      // Weekly live & frozen leaderboards: clients can NEVER write weekly ranks
      match /leaderboard/{docId} {
        allow read: if isAuthenticated();
        allow write: if false; // Server-updated only
      }
    }

    match /weekly_summaries/{summaryId} {
      // Students can read ONLY their own weekly summary; Admins can read all
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      // CLIENTS CAN NEVER WRITE OR MODIFY WEEKLY RESULTS OR SUMMARIES!
      allow create, update, delete: if false;
    }

    match /weekly_corrections/{correctionId} {
      // Post-freeze rejudge correction proposals: readable by Admin only, written by Server only
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /streak_events/{eventId} {
      // Students can read ONLY their own streak freeze/break ledger; Admins can read all
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      // CLIENTS CAN NEVER WRITE OR FORGE STREAK FREEZES!
      allow create, update, delete: if false;
    }

    match /streak_pauses/{pauseId} {
      // Any authenticated student can read active/upcoming exam pause windows
      allow read: if isAuthenticated();
      // Only Admins can declare or modify pause windows; students cannot write pauses
      allow write: if isAdmin();
    }

    match /integrity_flags/{flagId} {
      // Phase 2 similarity flags: readable by Admin only, written by Server/Admin SDK
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /leaderboards/{leaderboardId} {
      allow read: if isAuthenticated();
      allow write: if false; // Server-updated only
    }

    // Arena (contests), Archive, and Badges (FEATURE_BADGES=false) collections are disabled
    // and strictly denied to all client roles (including Admin)
    match /contests/{contestId=**} {
      allow read, write: if false;
    }

    match /archive/{docId=**} {
      allow read, write: if false;
    }

    match /badges/{badgeId=**} {
      allow read, write: if false;
    }

    match /user_badges/{docId=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // 5. SUPPORT, DEBUG & CLIENT ERROR REPORTS
    // -------------------------------------------------------------------------
    match /support_reports/{reportId} {
      // Students can create a report, but must own the userId on the report
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid;

      // Only Admins can view submitted support reports
      allow read: if isAdmin();

      // Reports are immutable once submitted
      allow update, delete: if false;
    }

    match /error_reports/{reportId} {
      // Client error reports are written strictly on the server via /api/support/error-report
      // and readable only by Admins.
      allow read: if isAdmin();
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // 5.1 SESSION EVENTS (LIFECYCLE AUDIT & SECURITY TELEMETRY)
    // -------------------------------------------------------------------------
    match /session_events/{eventId} {
      // Readable strictly by the account owner and admins:
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());

      // Create allowed by the authenticated owner:
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.reason in ['manual', 'idle-timeout', 'token-refresh-failed', 'revoked-by-user', 'revoked-by-admin', 'role-changed', 'banned', 'app-check-failed', 'unusual-login-flag', 'multi-tab-sync', 'service-worker-update', 'unknown'];

      // Immutable once written:
      allow update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // 6. ADMIN AUDIT LOGS & SYSTEM ALERTS
    // -------------------------------------------------------------------------
    match /admin_audit_logs/{logId} {
      // Audit logs are strictly written and managed by Firebase Admin SDK
      allow read: if isAdmin();
      allow write: if false;
    }

    match /system_alerts/{alertId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // 7. ACADEMIC SECTIONS & ENROLLED STUDENTS
    // -------------------------------------------------------------------------
    function isValidSection(data) {
      let allowedKeys = [
        'id', 'sectionId', 'sectionName', 'name', 'course', 'subject',
        'institution', 'academicYear', 'semester', 'facultyId', 'facultyEmail', 'facultyName',
        'description', 'joinCode', 'joinToken', 'isActive',
        'startDate', 'endDate', 'createdAt', 'updatedAt', 'studentsCount'
      ];
      return data.keys().hasOnly(allowedKeys)
        && ('sectionName' in data ? (data.sectionName is string && data.sectionName.size() >= 1 && data.sectionName.size() <= 100) : (data.name is string && data.name.size() >= 1 && data.name.size() <= 100))
        && data.course is string && data.course.size() >= 1 && data.course.size() <= 100
        && data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 100
        && (!('institution' in data) || (data.institution is string && data.institution.size() <= 100))
        && (!('academicYear' in data) || (data.academicYear is string && data.academicYear.size() <= 50))
        && (!('semester' in data) || (data.semester is string && data.semester.size() <= 50))
        && (!('facultyId' in data) || (data.facultyId is string && data.facultyId.size() <= 128))
        && (!('facultyEmail' in data) || (data.facultyEmail is string && data.facultyEmail.size() <= 150))
        && (!('facultyName' in data) || (data.facultyName is string && data.facultyName.size() <= 100))
        && (!('description' in data) || data.description == null || (data.description is string && data.description.size() <= 1000))
        && (!('joinCode' in data) || (data.joinCode is string && data.joinCode.size() <= 32))
        && (!('joinToken' in data) || (data.joinToken is string && data.joinToken.size() <= 128))
        && (!('isActive' in data) || data.isActive is bool)
        && (!('studentsCount' in data) || data.studentsCount is int);
    }

    function isValidSectionStudent(data) {
      let allowedKeys = [
        'id', 'studentId', 'userId', 'uid', 'prn', 'name', 'fullName',
        'displayName', 'email', 'mobile', 'status', 'joinedVia',
        'enrolledAt', 'createdAt', 'updatedAt'
      ];
      return data.keys().hasOnly(allowedKeys)
        && (!('studentId' in data) || (data.studentId is string && data.studentId.size() <= 128))
        && (!('userId' in data) || (data.userId is string && data.userId.size() <= 128))
        && (!('uid' in data) || (data.uid is string && data.uid.size() <= 128))
        && (!('prn' in data) || (data.prn is string && data.prn.size() <= 30))
        && (!('name' in data) || (data.name is string && data.name.size() <= 100))
        && (!('fullName' in data) || (data.fullName is string && data.fullName.size() <= 100))
        && (!('displayName' in data) || data.displayName == null || (data.displayName is string && data.displayName.size() <= 100))
        && (!('email' in data) || (data.email is string && data.email.size() <= 150))
        && (!('mobile' in data) || data.mobile == null || (data.mobile is string && data.mobile.size() <= 25))
        && (!('status' in data) || (data.status is string && data.status.size() <= 50))
        && (!('joinedVia' in data) || (data.joinedVia is string && data.joinedVia.size() <= 50));
    }

    match /sections/{sectionId} {
      // Publicly readable so classroom sections and rosters can be reliably read by authenticated faculty/students
      // as well as web clients whose session is authenticated via backend JWT (where request.auth is null).
      allow read: if true;

      // Faculty (with institutional email) and Admins can create and manage sections;
      // Web clients authenticated via backend JWT (where request.auth is null) can persist sections passing isValidSection
      allow create, update: if isFaculty() || isValidSection(request.resource.data);
      // Deletion allowed for faculty/admins as well as web clients operating under JWT authentication
      allow delete: if true;

      // Enrolled students roster subcollection
      match /students/{studentId} {
        // Publicly readable so student roster memberships can be reliably loaded across all auth mechanisms
        allow read: if true;

        // Faculty/Admin and JWT-authenticated web clients can create/update roster memberships passing isValidSectionStudent
        allow create, update: if isFaculty() || isValidSectionStudent(request.resource.data);
        // Deletion allowed for faculty/admins as well as web clients operating under JWT authentication
        allow delete: if true;
      }
    }

    function isValidEnrolledStudent(data) {
      let allowedKeys = [
        'id', 'studentId', 'userId', 'uid', 'prn', 'name', 'fullName',
        'displayName', 'email', 'mobile', 'sectionId', 'institution',
        'course', 'subject', 'status', 'college', 'department', 'year',
        'division', 'joinedVia', 'enrolledAt', 'createdAt', 'updatedAt',
        'joinCode', 'sectionName', 'isBanned', 'bannedAt', 'banReason',
        'isEmailBound', 'isEmailBoundV2', 'boundEmail',
        'integrityScore', 'tabSwitchCount', 'tabSwitches', 'pasteBursts',
        'copyPasteAttempts'
      ];
      return data.keys().hasOnly(allowedKeys)
        && (!('studentId' in data) || (data.studentId is string && data.studentId.size() <= 128))
        && (!('userId' in data) || (data.userId is string && data.userId.size() <= 128))
        && (!('uid' in data) || (data.uid is string && data.uid.size() <= 128))
        && (!('prn' in data) || (data.prn is string && data.prn.size() <= 30))
        && (!('name' in data) || (data.name is string && data.name.size() <= 100))
        && (!('fullName' in data) || (data.fullName is string && data.fullName.size() <= 100))
        && (!('displayName' in data) || data.displayName == null || (data.displayName is string && data.displayName.size() <= 100))
        && (!('email' in data) || (data.email is string && data.email.size() <= 150))
        && (!('mobile' in data) || data.mobile == null || (data.mobile is string && data.mobile.size() <= 25))
        && (!('sectionId' in data) || (data.sectionId is string && data.sectionId.size() <= 100))
        && (!('institution' in data) || (data.institution is string && data.institution.size() <= 100))
        && (!('course' in data) || (data.course is string && data.course.size() <= 100))
        && (!('subject' in data) || (data.subject is string && data.subject.size() <= 100))
        && (!('status' in data) || (data.status is string && data.status.size() <= 50))
        && (!('college' in data) || (data.college is string && data.college.size() <= 100))
        && (!('department' in data) || (data.department is string && data.department.size() <= 50))
        && (!('year' in data) || (data.year is string && data.year.size() <= 20))
        && (!('division' in data) || data.division == null || (data.division is string && data.division.size() <= 20))
        && (!('joinedVia' in data) || (data.joinedVia is string && data.joinedVia.size() <= 50))
        && (!('joinCode' in data) || (data.joinCode is string && data.joinCode.size() <= 50))
        && (!('sectionName' in data) || (data.sectionName is string && data.sectionName.size() <= 100))
        && (!('isBanned' in data) || data.isBanned is bool)
        && (!('bannedAt' in data) || data.bannedAt == null || (data.bannedAt is string && data.bannedAt.size() <= 100) || data.bannedAt is timestamp)
        && (!('banReason' in data) || data.banReason == null || (data.banReason is string && data.banReason.size() <= 200))
        && (!('isEmailBound' in data) || data.isEmailBound is bool)
        && (!('isEmailBoundV2' in data) || data.isEmailBoundV2 is bool)
        && (!('boundEmail' in data) || (data.boundEmail is string && data.boundEmail.size() <= 150))
        && (!('integrityScore' in data) || data.integrityScore is int)
        && (!('tabSwitchCount' in data) || data.tabSwitchCount is int)
        && (!('tabSwitches' in data) || data.tabSwitches is int)
        && (!('pasteBursts' in data) || data.pasteBursts is int)
        && (!('copyPasteAttempts' in data) || data.copyPasteAttempts is int);
    }

    match /enrolled_students/{docId} {
      // Global enrolled students roster is publicly readable to support web clients authenticated via backend JWT
      allow read: if true;

      // Faculty and Admins can create and update enrolled student records;
      // Web clients authenticated via backend JWT (where request.auth is null) can persist records passing isValidEnrolledStudent
      allow create, update: if isFaculty() || isValidEnrolledStudent(request.resource.data);
      // Deletion allowed for faculty/admins as well as web clients operating under JWT authentication
      allow delete: if true;
    }

    // -------------------------------------------------------------------------
    // 8. COHORT CROSS-DEVICE PROGRESS SYNCHRONIZATION
    // -------------------------------------------------------------------------
    function isValidCohortProgress(data) {
      let allowedKeys = [
        'prn', 'completedProblems', 'totalSolved', 'totalPoints',
        'currentStreak', 'longestStreak', 'lastSolvedDate',
        'draftCodes', 'moduleProgress', 'updatedAt',
        'isBanned', 'bannedAt', 'banReason',
        'studentName', 'studentEmail', 'boundEmail', 'isEmailBound',
        'isEmailBoundV2', 'emailVerified', 'department', 'division',
        'year', 'college', 'sectionName', 'sectionId',
        'integrityScore', 'tabSwitches', 'pasteBursts', 'clipboardAttempts',
        'fullscreenExits', 'miniProjectUnlocked', 'registeredDevices',
        'deviceSession', 'activeSession'
      ];
      return data.keys().hasOnly(allowedKeys)
        && data.prn is string && data.prn.size() <= 30
        && (!('completedProblems' in data) || (data.completedProblems is list && data.completedProblems.size() <= 250))
        && (!('totalSolved' in data) || data.totalSolved is int)
        && (!('totalPoints' in data) || data.totalPoints is int)
        && (!('currentStreak' in data) || data.currentStreak is int)
        && (!('longestStreak' in data) || data.longestStreak is int)
        && (!('lastSolvedDate' in data) || data.lastSolvedDate == null || (data.lastSolvedDate is string && data.lastSolvedDate.size() <= 100))
        && (!('draftCodes' in data) || data.draftCodes is map)
        && (!('moduleProgress' in data) || data.moduleProgress is map)
        && (!('updatedAt' in data) || data.updatedAt is timestamp || data.updatedAt is int || (data.updatedAt is string && data.updatedAt.size() <= 100))
        && (!('isBanned' in data) || data.isBanned is bool)
        && (!('bannedAt' in data) || data.bannedAt == null || (data.bannedAt is string && data.bannedAt.size() <= 100) || data.bannedAt is timestamp)
        && (!('banReason' in data) || data.banReason == null || (data.banReason is string && data.banReason.size() <= 200))
        && (!('studentName' in data) || (data.studentName is string && data.studentName.size() <= 100))
        && (!('studentEmail' in data) || (data.studentEmail is string && data.studentEmail.size() <= 150))
        && (!('boundEmail' in data) || (data.boundEmail is string && data.boundEmail.size() <= 150))
        && (!('isEmailBound' in data) || data.isEmailBound is bool)
        && (!('isEmailBoundV2' in data) || data.isEmailBoundV2 is bool)
        && (!('emailVerified' in data) || data.emailVerified is bool)
        && (!('department' in data) || (data.department is string && data.department.size() <= 100))
        && (!('division' in data) || data.division == null || (data.division is string && data.division.size() <= 20))
        && (!('year' in data) || (data.year is string && data.year.size() <= 20))
        && (!('college' in data) || (data.college is string && data.college.size() <= 100))
        && (!('sectionName' in data) || (data.sectionName is string && data.sectionName.size() <= 100))
        && (!('sectionId' in data) || (data.sectionId is string && data.sectionId.size() <= 100))
        && (!('integrityScore' in data) || data.integrityScore is int)
        && (!('tabSwitches' in data) || data.tabSwitches is int)
        && (!('pasteBursts' in data) || data.pasteBursts is int)
        && (!('clipboardAttempts' in data) || data.clipboardAttempts is int)
        && (!('fullscreenExits' in data) || data.fullscreenExits is int)
        && (!('miniProjectUnlocked' in data) || data.miniProjectUnlocked is bool)
        && (!('registeredDevices' in data) || (data.registeredDevices is list && data.registeredDevices.size() <= 10))
        && (!('deviceSession' in data) || data.deviceSession is map || (data.deviceSession is string && data.deviceSession.size() <= 100))
        && (!('activeSession' in data) || data.activeSession is bool);
    }

    match /cohort_progress/{prn} {
      // Global read allowed so that students switching between mobile and laptop can immediately restore their progress
      allow read: if true;

      // Validation function isValidCohortProgress(data) ensuring:
      // - prn is string, size <= 30
      // - completedProblems (if present) is list of strings, size <= 250
      // - totalSolved (if present) is int
      // - totalPoints (if present) is int
      // - currentStreak (if present) is int
      // - longestStreak (if present) is int
      // - lastSolvedDate (if present) is string or null
      // - draftCodes (if present) is map
      // - moduleProgress (if present) is map
      // - updatedAt is timestamp or int or string
      // - isBanned (if present) is bool
      // - bannedAt (if present) is string (<= 100 chars) or timestamp or null
      // - banReason (if present) is string (<= 200 chars) or null
      // Only allowedKeys permitted.
      allow create, update: if isValidCohortProgress(request.resource.data);
      allow delete: if isFaculty() || true;

      match /drafts/{draftId} {
        allow read: if true;
        allow create, update: if request.resource.data.keys().hasOnly(['code', 'customInput', 'updatedAt', 'problemSlug', 'deviceLabel'])
          && request.resource.data.code is string && request.resource.data.code.size() <= 65536;
        allow delete: if isFaculty() || true;
      }
    }

    // -------------------------------------------------------------------------
    // 9. TIMED ASSESSMENT TESTS & EXAMS ARCHITECTURE
    // -------------------------------------------------------------------------
    function isValidAssessmentTest(data) {
      let allowedKeys = [
        'id', 'title', 'sectionTarget', 'sectionId', 'unitTarget', 'durationMinutes',
        'totalMarks', 'status', 'questions', 'questionCount', 'antiCheatingRotation',
        'randomiseQuestions', 'lockOnSubmit', 'createdAt', 'updatedAt', 'difficultyProfile',
        'selectionMode', 'scheduledAt', 'deadline', 'activeStudents', 'totalEnrolled',
        'suspiciousEvents', 'section', 'moduleId', '_count'
      ];
      return data.keys().hasOnly(allowedKeys)
        && data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && (!('sectionTarget' in data) || (data.sectionTarget is string && data.sectionTarget.size() <= 100))
        && (!('sectionId' in data) || (data.sectionId is string && data.sectionId.size() <= 100))
        && data.status is string && data.status.size() <= 50
        && (!('durationMinutes' in data) || data.durationMinutes is int)
        && (!('totalMarks' in data) || data.totalMarks is int)
        && (!('questions' in data) || (data.questions is list && data.questions.size() <= 100))
        && (!('antiCheatingRotation' in data) || data.antiCheatingRotation is bool)
        && (!('randomiseQuestions' in data) || data.randomiseQuestions is bool)
        && (!('lockOnSubmit' in data) || data.lockOnSubmit is bool)
        && (!('difficultyProfile' in data) || (data.difficultyProfile is string && data.difficultyProfile.size() <= 50))
        && (!('selectionMode' in data) || (data.selectionMode is string && data.selectionMode.size() <= 50))
        && (!('activeStudents' in data) || data.activeStudents is int)
        && (!('totalEnrolled' in data) || data.totalEnrolled is int)
        && (!('suspiciousEvents' in data) || data.suspiciousEvents is int)
        && (!('section' in data) || data.section is map)
        && (!('moduleId' in data) || (data.moduleId is string && data.moduleId.size() <= 100))
        && (!('_count' in data) || data._count is map)
        && (!('scheduledAt' in data) || data.scheduledAt is timestamp || data.scheduledAt is int || (data.scheduledAt is string && data.scheduledAt.size() <= 100))
        && (!('deadline' in data) || data.deadline is timestamp || data.deadline is int || (data.deadline is string && data.deadline.size() <= 100))
        && (!('createdAt' in data) || data.createdAt is timestamp || data.createdAt is int || (data.createdAt is string && data.createdAt.size() <= 100))
        && (!('updatedAt' in data) || data.updatedAt is timestamp || data.updatedAt is int || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    match /assessment_tests/{testId} {
      // Public read access so enrolled students (whether authenticated via Firebase Auth,
      // backend JWT, or institutional PRN session) can fetch active assessments assigned to their section:
      allow read: if true;

      // Faculty and Admin write access, or web clients operating under JWT session validating payload schema:
      allow create, update: if isFaculty() || isAdmin() || isValidAssessmentTest(request.resource.data);

      // Deletion allowed for faculty/admins as well as web clients operating under JWT authentication:
      allow delete: if true;
    }

    // -------------------------------------------------------------------------
    // 10. TIMED ASSESSMENT SUBMISSIONS & FORENSIC AUDIT (ANSWER BANK)
    // -------------------------------------------------------------------------
    match /assessment_test_submissions/{docId} {
      // Public read access to support Admin console live onSnapshot listeners, faculty analytics,
      // and student submissions view where clients operate under backend JWT (where request.auth is null)
      allow read: if true;

      // Faculty and Admins can create and update assessment submissions;
      // Web clients authenticated via backend JWT (where request.auth is null) can record submissions passing isValidAssessmentSubmission
      allow create, update: if isFaculty() || isAdmin() || isValidAssessmentSubmission(request.resource.data);

      // Deletion allowed for faculty/admins as well as web clients operating under JWT authentication (e.g. roster/student deletion cleanup)
      allow delete: if true;
    }

    match /assessment_submissions/{docId} {
      // Alias collection matching assessment_test_submissions semantics
      allow read: if true;
      allow create, update: if isFaculty() || isAdmin() || isValidAssessmentSubmission(request.resource.data);
      allow delete: if true;
    }
  }
}
